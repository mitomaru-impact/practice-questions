import javax.swing.*;
import java.awt.*;
import java.util.ArrayList;
import java.util.Random;

public class game extends JFrame {

    // =========================
    // カードクラス
    // =========================
    static class Card {

        String name;
        int rarity;
        int attack;

        Card(String name, int rarity, int attack) {
            this.name = name;
            this.rarity = rarity;
            this.attack = attack;
        }

        String getStars() {
            StringBuilder stars = new StringBuilder();

            for (int i = 0; i < rarity; i++) {
                stars.append("★");
            }

            return stars.toString();
        }
    }

    // =========================
    // カード一覧
    // =========================
    ArrayList<Card> cards = new ArrayList<>();

    // 入手したカード
    ArrayList<Card> collection = new ArrayList<>();

    Random random = new Random();

    // 所持コイン
    int coins = 1000;

    // 画面部品
    JLabel coinLabel;
    JLabel collectionLabel;
    JLabel resultLabel;
    JLabel cardNameLabel;
    JLabel rarityLabel;
    JLabel attackLabel;

    JButton gachaButton;
    JButton tenGachaButton;
    JButton collectionButton;

    // =========================
    // メイン
    // =========================
    public static void main(String[] args) {

        SwingUtilities.invokeLater(() -> {

            game game = new game();

            game.setVisible(true);
        });
    }

    // =========================
    // ゲーム画面
    // =========================
    public game() {

        setTitle("★ CARD GACHA GAME ★");

        setSize(600, 650);

        setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);

        setLocationRelativeTo(null);

        createCards();

        createGameScreen();
    }

    // =========================
    // 画面を作る
    // =========================
    void createGameScreen() {

        // 全体
        JPanel mainPanel = new JPanel();

        mainPanel.setLayout(new BorderLayout());

        mainPanel.setBackground(new Color(25, 25, 45));

        // =========================
        // タイトル
        // =========================
        JLabel titleLabel = new JLabel("★ CARD GACHA ★");

        titleLabel.setHorizontalAlignment(SwingConstants.CENTER);

        titleLabel.setFont(new Font("Serif", Font.BOLD, 32));

        titleLabel.setForeground(Color.WHITE);

        titleLabel.setBorder(
                BorderFactory.createEmptyBorder(20, 10, 20, 10)
        );

        mainPanel.add(titleLabel, BorderLayout.NORTH);

        // =========================
        // 中央
        // =========================
        JPanel centerPanel = new JPanel();

        centerPanel.setLayout(
                new BoxLayout(centerPanel, BoxLayout.Y_AXIS)
        );

        centerPanel.setBackground(new Color(25, 25, 45));

        // コイン
        coinLabel = new JLabel("💰 コイン：1000");

        coinLabel.setAlignmentX(Component.CENTER_ALIGNMENT);

        coinLabel.setFont(new Font("SansSerif", Font.BOLD, 22));

        coinLabel.setForeground(Color.YELLOW);

        centerPanel.add(coinLabel);

        centerPanel.add(Box.createVerticalStrut(10));

        // コレクション
        collectionLabel = new JLabel("📚 カード：0 / 15");

        collectionLabel.setAlignmentX(Component.CENTER_ALIGNMENT);

        collectionLabel.setFont(new Font("SansSerif", Font.BOLD, 18));

        collectionLabel.setForeground(Color.WHITE);

        centerPanel.add(collectionLabel);

        centerPanel.add(Box.createVerticalStrut(30));

        // =========================
        // カード表示エリア
        // =========================
        JPanel cardPanel = new JPanel();

        cardPanel.setLayout(
                new BoxLayout(cardPanel, BoxLayout.Y_AXIS)
        );

        cardPanel.setBackground(new Color(45, 45, 75));

        cardPanel.setBorder(
                BorderFactory.createLineBorder(
                        new Color(120, 120, 180),
                        3
                )
        );

        cardPanel.setMaximumSize(
                new Dimension(450, 280)
        );

        cardPanel.setPreferredSize(
                new Dimension(450, 280)
        );

        // 結果
        resultLabel = new JLabel("ガチャを引こう！");

        resultLabel.setAlignmentX(Component.CENTER_ALIGNMENT);

        resultLabel.setFont(
                new Font("SansSerif", Font.BOLD, 24)
        );

        resultLabel.setForeground(Color.WHITE);

        cardPanel.add(Box.createVerticalStrut(25));

        cardPanel.add(resultLabel);

        cardPanel.add(Box.createVerticalStrut(25));

        // カード名
        cardNameLabel = new JLabel("？？？");

        cardNameLabel.setAlignmentX(Component.CENTER_ALIGNMENT);

        cardNameLabel.setFont(
                new Font("SansSerif", Font.BOLD, 32)
        );

        cardNameLabel.setForeground(Color.WHITE);

        cardPanel.add(cardNameLabel);

        cardPanel.add(Box.createVerticalStrut(15));

        // レア度
        rarityLabel = new JLabel("？？？？？");

        rarityLabel.setAlignmentX(Component.CENTER_ALIGNMENT);

        rarityLabel.setFont(
                new Font("SansSerif", Font.BOLD, 28)
        );

        rarityLabel.setForeground(Color.YELLOW);

        cardPanel.add(rarityLabel);

        cardPanel.add(Box.createVerticalStrut(15));

        // 攻撃力
        attackLabel = new JLabel("攻撃力：？？？");

        attackLabel.setAlignmentX(Component.CENTER_ALIGNMENT);

        attackLabel.setFont(
                new Font("SansSerif", Font.BOLD, 20)
        );

        attackLabel.setForeground(Color.WHITE);

        cardPanel.add(attackLabel);

        centerPanel.add(cardPanel);

        centerPanel.add(Box.createVerticalStrut(30));

        // =========================
        // ガチャボタン
        // =========================
        gachaButton = new JButton("🎰 ガチャを引く！ (100コイン)");

        gachaButton.setAlignmentX(Component.CENTER_ALIGNMENT);

        gachaButton.setFont(
                new Font("SansSerif", Font.BOLD, 20)
        );

        gachaButton.setPreferredSize(
                new Dimension(350, 55)
        );

        gachaButton.setMaximumSize(
                new Dimension(400, 55)
        );

        gachaButton.addActionListener(e -> gacha());

        centerPanel.add(gachaButton);

        centerPanel.add(Box.createVerticalStrut(10));

        // =========================
        // 10連ボタン
        // =========================
        tenGachaButton =
                new JButton("🔥 10連ガチャ！ (1000コイン)");

        tenGachaButton.setAlignmentX(Component.CENTER_ALIGNMENT);

        tenGachaButton.setFont(
                new Font("SansSerif", Font.BOLD, 18)
        );

        tenGachaButton.setMaximumSize(
                new Dimension(400, 50)
        );

        tenGachaButton.addActionListener(e -> tenGacha());

        centerPanel.add(tenGachaButton);

        centerPanel.add(Box.createVerticalStrut(10));

        // =========================
        // 図鑑ボタン
        // =========================
        collectionButton =
                new JButton("📚 カード図鑑");

        collectionButton.setAlignmentX(Component.CENTER_ALIGNMENT);

        collectionButton.setFont(
                new Font("SansSerif", Font.BOLD, 18)
        );

        collectionButton.setMaximumSize(
                new Dimension(400, 50)
        );

