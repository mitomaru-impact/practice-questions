        centerPanel.add(collectionButton);

        mainPanel.add(centerPanel, BorderLayout.CENTER);

        add(mainPanel);
    }

    // =========================
    // カードを作成
    // =========================
    void createCards() {

        // ★1
        cards.add(new Card("スライム", 1, 10));
        cards.add(new Card("ゴブリン", 1, 15));
        cards.add(new Card("コウモリ", 1, 12));
        cards.add(new Card("小さな妖精", 1, 18));

        // ★2
        cards.add(new Card("オオカミ", 2, 30));
        cards.add(new Card("オーク", 2, 40));
        cards.add(new Card("魔法使い", 2, 45));
        cards.add(new Card("騎士", 2, 50));

        // ★3
        cards.add(new Card("炎の魔導士", 3, 80));
        cards.add(new Card("ドラゴンナイト", 3, 100));
        cards.add(new Card("暗黒騎士", 3, 110));

        // ★4
        cards.add(new Card("古代ドラゴン", 4, 200));
        cards.add(new Card("聖騎士", 4, 220));

        // ★5
        cards.add(new Card("伝説の勇者", 5, 500));
        cards.add(new Card("神龍", 5, 1000));
    }

    // =========================
    // 1回ガチャ
    // =========================
    void gacha() {

        if (coins < 100) {

            JOptionPane.showMessageDialog(
                    this,
                    "コインが足りません！",
                    "エラー",
                    JOptionPane.WARNING_MESSAGE
            );

            return;
        }

        coins -= 100;

        updateStatus();

        resultLabel.setText("ガチャ中...");

        cardNameLabel.setText("？？？");

        rarityLabel.setText("？？？？？");

        attackLabel.setText("攻撃力：？？？");

        // 少し演出を入れる
        Timer timer = new Timer(800, e -> {

            Card card = getRandomCard();

            showCard(card);

        });

        timer.setRepeats(false);

        timer.start();
    }

    // =========================
    // 10連ガチャ
    // =========================
    void tenGacha() {

        if (coins < 1000) {

            JOptionPane.showMessageDialog(
                    this,
                    "10連ガチャには1000コイン必要です！",
                    "コイン不足",
                    JOptionPane.WARNING_MESSAGE
            );

            return;
        }

        coins -= 1000;

        updateStatus();

        // 10連の中から最後の1枚を表示
        Card[] results = new Card[10];

        for (int i = 0; i < 10; i++) {

            results[i] = getRandomCard();

            addCollection(results[i]);
        }

        Card lastCard = results[9];

        showCard(lastCard);

        StringBuilder message = new StringBuilder();

        message.append("10連ガチャ結果\n\n");

        for (int i = 0; i < 10; i++) {

            message.append(
                    (i + 1)
                    + "枚目："
                    + results[i].name
                    + " "
                    + results[i].getStars()
                    + "\n"
            );
        }

        JOptionPane.showMessageDialog(
                this,
                message.toString(),
                "★ 10連ガチャ結果 ★",
                JOptionPane.INFORMATION_MESSAGE
        );
    }

    // =========================
    // ランダムカード
    // =========================
    Card getRandomCard() {

        int number = random.nextInt(100);

        int targetRarity;

        /*
         * ★1 → 70%
         * ★2 → 20%
         * ★3 → 7%
         * ★4 → 2%
         * ★5 → 1%
         */

        if (number < 70) {

            targetRarity = 1;

        } else if (number < 90) {

            targetRarity = 2;

        } else if (number < 97) {

            targetRarity = 3;

        } else if (number < 99) {

            targetRarity = 4;

        } else {

            targetRarity = 5;
        }

        ArrayList<Card> rarityCards =
                new ArrayList<>();

        for (Card card : cards) {

            if (card.rarity == targetRarity) {

                rarityCards.add(card);
            }
        }

        return rarityCards.get(
                random.nextInt(rarityCards.size())
        );
    }

    // =========================
    // カードを表示
    // =========================
    void showCard(Card card) {

        resultLabel.setText("🎉 ガチャ結果！");

        cardNameLabel.setText(card.name);

        rarityLabel.setText(card.getStars());

        attackLabel.setText(
                "攻撃力：" + card.attack
        );

        addCollection(card);

        // レア度によって色を変更
        if (card.rarity == 5) {

            rarityLabel.setForeground(
                    new Color(255, 80, 80)
            );

            resultLabel.setText(
                    "🔥🔥 超激レア！！ 🔥🔥"
            );

        } else if (card.rarity == 4) {

            rarityLabel.setForeground(
                    new Color(255, 150, 0)
            );

            resultLabel.setText(
                    "✨ 激レア！ ✨"
            );

        } else if (card.rarity == 3) {

            rarityLabel.setForeground(
                    Color.YELLOW
            );

            resultLabel.setText(
                    "⭐ レア！ ⭐"
            );

        } else {

            rarityLabel.setForeground(
                    Color.LIGHT_GRAY
            );
        }
    }

    // =========================
    // 図鑑に登録
    // =========================
    void addCollection(Card card) {

        boolean alreadyHave = false;

        for (Card owned : collection) {

            if (owned.name.equals(card.name)) {

                alreadyHave = true;

                break;
            }
        }

        if (!alreadyHave) {

            collection.add(card);
        }

        updateStatus();
    }

    // =========================
    // ステータス更新
    // =========================
    void updateStatus() {

        coinLabel.setText(
                "💰 コイン：" + coins
        );

        collectionLabel.setText(
                "📚 カード："
                + collection.size()
                + " / "
                + cards.size()
        );

        if (coins < 100) {

            gachaButton.setEnabled(false);

        } else {

            gachaButton.setEnabled(true);
        }

        if (coins < 1000) {

            tenGachaButton.setEnabled(false);

        } else {

            tenGachaButton.setEnabled(true);
        }
    }

    // =========================
    // カード図鑑
    // =========================
    void showCollection() {

        StringBuilder message =
                new StringBuilder();

        message.append(
                "★ カード図鑑 ★\n\n"
        );

        for (Card card : cards) {

            boolean have = false;

            for (Card owned : collection) {

                if (owned.name.equals(card.name)) {

                    have = true;

                    break;
                }
            }

            if (have) {

                message.append(
                        "✅ "
                        + card.name
                        + " "
                        + card.getStars()
                        + "　攻撃力："
                        + card.attack
                        + "\n"
                );

            } else {

                message.append(
                        "❌ ？？？？？\n"
                );
            }
        }

        message.append(
                "\nコンプリート率："
                + collection.size()
                + " / "
                + cards.size()
        );

        if (collection.size() == cards.size()) {

            message.append(
                    "\n\n🎉🎉🎉 コンプリート達成！ 🎉🎉🎉"
            );
        }

        JOptionPane.showMessageDialog(
                this,
                message.toString(),
                "📚 カード図鑑",
                JOptionPane.INFORMATION_MESSAGE
        );
    }
}
